rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All existing user data (routines, tasks, birthdays, endedDays, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared shopping lists
    match /lists/{listId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      allow read:   if isMember();
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.ownerId
                   && request.auth.uid in request.resource.data.members;
      // Members may edit list settings, or remove only themselves (leave).
      // Joining happens server-side in the joinListByCode function.
      allow update: if isMember() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'inviteCode', 'hasInventory'])
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        )
      );
      // Owner, or the last remaining member, may delete the list
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || (isMember() && resource.data.members.size() == 1)
      );

      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
      match /tags/{tagId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
      match /inventory/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
    }
  }
}
